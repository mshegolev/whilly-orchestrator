<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Whilly Cockpit</title>
  <script src="/static/whilly-theme.js"></script>
  <script src="/static/whilly-navigation.js" defer></script>
  <link rel="stylesheet" href="/static/whilly-design.css"><link rel="stylesheet" href="/static/whilly-app.css">
  <style>
    :root{--line-strong:var(--line);--ok:#75d99a;--warn:#f5c36a}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:var(--font-mono);font-size:13px;line-height:1.45}body{overflow-x:hidden}.cockpit{min-height:100dvh;display:flex;flex-direction:column}
    .topbar{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.5rem 1rem;background:var(--surface-strong);border-bottom:1px solid var(--line-strong)}.brand{display:flex;align-items:center;gap:.6rem;font-weight:700;text-transform:uppercase}.brand-mark{color:var(--accent);font-size:1.2rem}.topnav{display:flex;gap:1rem;padding-left:1rem;border-left:1px solid var(--line);font-size:10px;font-weight:700;text-transform:uppercase}.topnav a{color:var(--muted)}.topnav a:hover{color:var(--accent)}.feature-picker{display:flex;align-items:center;gap:.5rem;padding:.25rem .5rem;border:1px solid var(--line);background:var(--bg)}.feature-picker label{margin:0}.feature-picker select{border:0;color:var(--accent);padding:.2rem;background:transparent}
    .cockpit-main{flex:1;display:grid;grid-template-columns:minmax(0,2fr) minmax(18rem,1fr);min-height:0}.primary-path{padding:1.5rem;border-right:1px solid var(--line-strong)}.side-path{padding:1rem;background:color-mix(in srgb,var(--surface) 55%,transparent);overflow:auto}.panel{border:1px solid var(--line-strong);background:var(--surface);margin-bottom:.75rem}.panel-header{display:flex;align-items:center;gap:.5rem;padding:.45rem .65rem;background:var(--surface-strong);border-bottom:1px solid var(--line-strong);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.panel-header.split{justify-content:space-between}.panel-body{padding:1rem}.step-number{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;background:var(--text);color:var(--bg);font-size:10px}.step-panel{border-left:3px solid var(--line)}.step-panel:focus-within,.step-panel.active{border-left-color:var(--accent)}.step-panel.run-step{border-left-color:var(--ok)}
    button,input,select,textarea{font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line);padding:.4rem .55rem}button{cursor:pointer;background:var(--accent);color:var(--bg);font-weight:700;text-transform:uppercase;letter-spacing:.02em}button:hover:not(:disabled){background:var(--text);color:var(--bg);border-color:var(--text)}button:disabled{opacity:.45;cursor:not-allowed}.btn-ghost{background:transparent;color:var(--text)}.btn-ok{background:var(--ok);color:var(--bg)}.btn-danger{background:var(--danger);color:var(--bg)}.btn-small{min-height:28px;font-size:10px;padding:.25rem .55rem}.full{width:100%}
    input,select,textarea{width:100%}textarea{min-height:120px;resize:vertical}.field-label,label{display:block;margin-bottom:.3rem;color:var(--muted);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.feature-toolbar{display:grid;grid-template-columns:minmax(0,1fr) minmax(8rem,12rem) auto;gap:.5rem;align-items:end}.actions{display:flex;flex-wrap:wrap;gap:.5rem}.step-meta{margin:0 0 .35rem;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.muted{color:var(--muted)}.error{color:var(--danger);min-height:1.3em}.code-block,pre{background:var(--bg);border:1px solid var(--line);padding:.65rem;white-space:pre-wrap;overflow:auto;overflow-wrap:anywhere}.status-line{font-weight:700;text-transform:uppercase;letter-spacing:.04em}.warning{display:flex;gap:.5rem;align-items:center;margin-top:1rem;padding:.5rem;background:var(--bg);border:1px solid var(--line);color:var(--muted);font-size:11px}.warning-mark{color:var(--warn)}
    details.panel>summary{list-style:none;cursor:pointer;padding:.55rem .65rem;background:var(--surface-strong);font-weight:700;font-size:11px;text-transform:uppercase;color:var(--muted)}details.panel>summary::-webkit-details-marker{display:none}details.panel[open]>summary{border-bottom:1px solid var(--line-strong)}details.panel>.panel-body{padding:.75rem}.side-path .panel-header{font-size:11px}.footerbar{display:flex;justify-content:space-between;gap:1rem;padding:.3rem 1rem;background:var(--surface-strong);border-top:1px solid var(--line-strong);color:var(--muted);font-size:10px;text-transform:uppercase;font-weight:700}.footerbar .live{color:var(--accent)}
    @media(max-width:850px){.topbar{align-items:flex-start;flex-direction:column}.topnav{padding-left:0;border-left:0}.feature-picker{width:100%}.cockpit-main{grid-template-columns:1fr}.primary-path{border-right:0;padding:1rem}.feature-toolbar{grid-template-columns:1fr}.side-path{padding:.75rem}.footerbar{flex-direction:column;gap:.2rem}}
  </style>
</head>
<body><div class="cockpit">
  <header class="topbar"><div class="brand"><span class="brand-mark">&gt;_</span><span>Whilly Cockpit</span><nav class="topnav"><a href="/">[Dashboard]</a><a href="/swarm?session=">[Swarm Gantt]</a></nav></div><div class="feature-picker"><label for="feature-list">Active feature:</label><select id="feature-list"><option value="">— new task —</option></select><button id="create-feature-btn" class="btn-ghost btn-small">+ New</button></div></header>
  <main class="cockpit-main"><section class="primary-path"><p id="product-error" class="error" role="alert"></p>
    <section id="step-1" class="panel step-panel active"><header class="panel-header"><span class="step-number">1</span><span>Describe task &amp; intent</span></header><div class="panel-body"><p class="muted">Что изменить в IC, какие проекты затронуты и как проверить результат.</p><ul id="message-history"></ul><textarea id="message-input" aria-label="Task description" placeholder="Enter requirements for IC: what to change, target projects, and verification protocol..."></textarea><div class="actions"><button id="message-btn">Save task</button><button id="discuss-btn" class="btn-ghost" disabled>Discuss</button></div><p id="planning-note" class="muted">После сохранения выберите planner profile и переходите к шагу 2.</p></div></section>
    <section id="step-2" class="panel step-panel"><header class="panel-header"><span class="step-number">2</span><span>Build execution plan</span></header><div class="panel-body"><div class="feature-toolbar"><label>Planner profile<select id="planner-profile"><option value="">— выберите профиль —</option>{% for profile in planner_profiles %}<option value="{{ profile }}" {% if profile not in available_planners %}disabled{% endif %}>{{ profile }}{% if profile not in available_planners %} — не настроен{% endif %}</option>{% endfor %}</select></label><span></span><button id="plan-btn" disabled>Build plan</button></div><p id="strong-profile-note" class="muted">{% if not available_planners %}planner_setup_required: настройте модель и бюджет планировщика в реестре.{% else %}План строится на текущей задаче и контексте проектов.{% endif %}</p></div></section>
    <section id="step-3" class="panel step-panel"><header class="panel-header split"><span><span class="step-number">3</span> Review &amp; approve</span><span class="muted">Revision: <input id="approval-revision" type="number" style="width:4rem"> · Digest: <code id="approval-digest">—</code></span></header><div class="panel-body"><p id="feature-status" class="status-line">—</p><p>Blocker: <span id="feature-blocker">—</span></p><a id="feature-session-link" href="/swarm" hidden>Open canonical plan and task Gantt</a><h3>Specification</h3><pre id="feature-spec" class="code-block">—</pre><div class="actions"><button id="approve-btn">Approve plan</button><button id="publish-btn" class="btn-ghost">Publish spec</button></div></div></section>
    <section id="step-4" class="panel step-panel run-step"><header class="panel-header"><span class="step-number">4</span><span>Run agent swarm</span></header><div class="panel-body"><div class="feature-toolbar"><label>Workers<input id="workers" type="number" min="1" max="5" value="1"></label><div><label>Session status</label><div id="run-status" class="status-line muted">Awaiting approval</div></div><div class="actions"><button id="run-btn" class="btn-ok">Run swarm</button><button id="stop-btn" class="btn-danger">Stop</button></div></div><div class="warning"><span class="warning-mark">[!]</span><span>Agents operate within budget constraints. Human approval is required before execution.</span></div></div></section>
  </section><aside class="side-path"><section class="panel"><header class="panel-header">Swarm constraints</header><div class="panel-body"><div class="feature-toolbar"><label>Max calls<input id="budget-max-calls" type="number" min="1" value="60"></label><label>Max time (s)<input id="budget-max-elapsed" type="number" min="1" value="7200"></label><button id="budget-btn" class="btn-ghost btn-small">Update</button></div></div></section>
    <details class="panel"><summary>Shared knowledge</summary><div class="panel-body"><p id="knowledge-status" class="muted">Knowledge backend status not loaded.</p><button id="knowledge-status-btn" class="btn-ghost btn-small">[Refresh]</button><label>Project id<input id="knowledge-project" placeholder="project-id"></label><button id="knowledge-load-btn" class="btn-ghost btn-small">Load context</button><pre id="knowledge-result">No knowledge requested.</pre></div></details>
    <details class="panel"><summary>Agent collaboration</summary><div class="panel-body"><p id="collaboration-status" role="status" class="muted">Delivery status not loaded.</p><button id="collaboration-load-btn" class="btn-ghost full">View delivery history</button><pre id="collaboration-result">No delivery history requested.</pre></div></details>
    <details class="panel"><summary>Cross-project proposals</summary><div class="panel-body"><button id="proposal-load-btn" class="btn-ghost btn-small">Check updates</button><label>External changes<select id="proposal-list"></select></label><p id="proposal-status" role="status">Proposals not loaded.</p><a id="proposal-feature-link" href="/swarm/product" hidden>Open originating feature</a><pre id="proposal-detail">No proposal selected.</pre><label>Decision reason<input id="proposal-reason" maxlength="256" placeholder="Evidence and reason"></label><div class="actions"><button id="proposal-accept-btn" disabled>Accept</button><button id="proposal-reject-btn" class="btn-ghost" disabled>Reject</button></div></div></details>
    <details class="panel"><summary>Research &amp; evaluation</summary><div class="panel-body"><p id="learning-status" role="status" class="muted">Learning activation status not loaded.</p><button id="learning-status-btn" class="btn-ghost btn-small">Refresh status</button><label>Research run id<input id="learning-report-id" maxlength="128" placeholder="run-id"></label><button id="learning-report-btn" class="btn-ghost btn-small">Load report</button><label>Experiment id<input id="learning-experiment-id" maxlength="128" placeholder="experiment-id"></label><button id="learning-experiment-btn" class="btn-ghost btn-small">Load evaluation</button><pre id="learning-evidence">No report or evaluation requested.</pre></div></details>
    <details class="panel"><summary>Receipts &amp; artifacts</summary><div class="panel-body"><ul id="publication-receipts" class="muted"><li>No artifacts generated.</li></ul></div></details>
  </aside></main><footer class="footerbar"><span>WHILLY_CORE · LOCAL CONTROL PLANE</span><span class="live">[LIVE · SAFE MODE]</span></footer><script src="/static/product-swarm.js?v=20261007-learning"></script>
</div></body></html>
